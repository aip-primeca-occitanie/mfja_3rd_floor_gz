<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>staubli_tx2_60l_position_commander</name>
  <version>0.0.0</version>
  <description>Launch files principaux pour la simulation complète</description>
  <maintainer email="benjamin.folie@student.isae-supaero.fr">benjamin</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- dep -->   
  <depend>rclcpp</depend>   
  <depend>std_msgs</depend>   
  <depend>geometry_msgs</depend>   
  <depend>sensor_msgs</depend>   
  <depend>visualization_msgs</depend>   
  <depend>tf2_ros</depend>   
  <depend>tf2_geometry_msgs</depend>
  <depend>trajectory_msgs</depend>    
  
  <!-- ros2_control -->   
  <depend>controller_manager</depend>   
  <depend>ros2_control</depend>   
  <depend>ros2_controllers</depend>   
  <depend>hardware_interface</depend>    

  <!-- desc -->   
  <depend>staubli_tx2_60l_description</depend> 

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
