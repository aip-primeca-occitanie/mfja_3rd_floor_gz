<?xml version="1.0"?>
<sdf version="1.7">
  <model name="room315_visual_observation_rig">
    <static>true</static>

    <link name="right_rail_rgbd_camera_link">
      <pose>-14.9 -4.70 4.2 0 1.5708 0</pose>

      <visual name="camera_body_visual">
        <geometry>
          <box>
            <size>0.24 0.16 0.09</size>
          </box>
        </geometry>
        <material>
          <ambient>0.04 0.045 0.055 1</ambient>
          <diffuse>0.04 0.045 0.055 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>

      <visual name="camera_lens_visual">
        <pose>0.14 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.025 1</ambient>
          <diffuse>0.02 0.02 0.025 1</diffuse>
          <specular>0.8 0.8 0.9 1</specular>
        </material>
      </visual>

      <sensor name="room315_right_rail_rgbd" type="rgbd_camera">
        <!-- Move the sensor in front of the camera body/lens so it does not see its own visual geometry. -->
        <pose>0.25 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>/room_315/perception/right_rail_rgbd</topic>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.15</near>
            <far>5.0</far>
          </clip>
          <optical_frame_id>room315_right_rail_rgbd_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </link>

    <link name="left_rail_rgbd_camera_link">
      <pose>-10.9 -4.70 4.2 0 1.5708 0</pose>

      <visual name="camera_body_visual">
        <geometry>
          <box>
            <size>0.24 0.16 0.09</size>
          </box>
        </geometry>
        <material>
          <ambient>0.04 0.045 0.055 1</ambient>
          <diffuse>0.04 0.045 0.055 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>

      <visual name="camera_lens_visual">
        <pose>0.14 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.025 1</ambient>
          <diffuse>0.02 0.02 0.025 1</diffuse>
          <specular>0.8 0.8 0.9 1</specular>
        </material>
      </visual>

      <sensor name="room315_left_rail_rgbd" type="rgbd_camera">
        <!-- Move the sensor in front of the camera body/lens so it does not see its own visual geometry. -->
        <pose>0.25 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>/room_315/perception/left_rail_rgbd</topic>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.15</near>
            <far>5.0</far>
          </clip>
          <optical_frame_id>room315_left_rail_rgbd_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </link>

    <link name="slot_fiducial_placeholders_link">
