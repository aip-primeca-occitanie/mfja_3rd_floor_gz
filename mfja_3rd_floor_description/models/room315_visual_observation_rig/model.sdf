        </material>
      </visual>

      <visual name="left_slot_3_marker">
        <pose>-10.609 -5.543 0.856 0 0 0</pose>
        <geometry>
          <box>
            <size>0.16 0.10 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.52 0.32 0.0 1</ambient>
          <diffuse>1.0 0.66 0.0 1</diffuse>
        </material>
      </visual>

      <visual name="left_slot_4_marker">
        <pose>-10.14 -5.543 0.856 0 0 0</pose>
        <geometry>
          <box>
            <size>0.16 0.10 0.012</size>
