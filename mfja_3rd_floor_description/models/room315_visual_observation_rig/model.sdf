          <box>
            <size>0.16 0.10 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.1 0.55 1</ambient>
          <diffuse>0.0 0.18 1.0 1</diffuse>
        </material>

      </visual>

      <visual name="right_slot_2_marker">
