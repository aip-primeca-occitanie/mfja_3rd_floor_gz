<?xml version="1.0"?>
<sdf version="1.9">
  <model name="room315_shuttle_identity_frame">
    <static>false</static>
    <link name="identity_frame_link">
      <kinematic>true</kinematic>
      <gravity>false</gravity>
      <!-- Center keep-out plate shows where payloads may sit; the four corner tabs are identity-safe zones. -->
      <visual name="payload_keepout_boundary_center">
        <pose>0 0 0.032 0 0 0</pose>
        <geometry><box><size>0.160 0.110 0.003</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 0.35</ambient>
          <diffuse>0.05 0.05 0.05 0.35</diffuse>
          <emissive>0.0 0.0 0.0 1</emissive>
        </material>
      </visual>
      <visual name="identity_safe_region_front_left">
        <pose>0.125 0.082 0.044 0 0 0</pose>
        <geometry><box><size>0.070 0.040 0.006</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
      <visual name="identity_safe_region_front_right">
        <pose>0.125 -0.082 0.044 0 0 0</pose>
        <geometry><box><size>0.070 0.040 0.006</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
      <visual name="identity_safe_region_rear_left">
        <pose>-0.125 0.082 0.044 0 0 0</pose>
        <geometry><box><size>0.070 0.040 0.006</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
      <visual name="identity_safe_region_rear_right">
        <pose>-0.125 -0.082 0.044 0 0 0</pose>
        <geometry><box><size>0.070 0.040 0.006</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
