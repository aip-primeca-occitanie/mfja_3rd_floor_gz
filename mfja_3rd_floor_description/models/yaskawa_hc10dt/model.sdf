        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.05</iyy>
          <izz>0.04</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="link_3_u_visual">
