<?xml version="1.0"?>
<sdf version="1.9">
  <model name="yaskawa_hc10">
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="base_link">
      <inertial>
        <pose>0 0 0.10 0 0 0</pose>
        <mass>24.0</mass>
        <inertia>
          <ixx>0.35</ixx>
          <iyy>0.35</iyy>
          <izz>0.30</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="base_link_visual">
        <geometry>
          <mesh>
            <uri>model://yaskawa_hc10/meshes/hc10/visual/base_link.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="link_1_s">
      <pose relative_to="joint_1_s">0 0 0 0 0 0</pose>
      <inertial>
        <mass>8.5</mass>
        <inertia>
          <ixx>0.07</ixx>
          <iyy>0.07</iyy>
          <izz>0.05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="link_1_s_visual">
        <geometry>
          <mesh>
            <uri>model://yaskawa_hc10/meshes/hc10/visual/link_1_s.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="link_2_l">
      <pose relative_to="joint_2_l">0 0 0 0 0 0</pose>
      <inertial>
        <mass>7.0</mass>
        <inertia>
          <ixx>0.06</ixx>
          <iyy>0.06</iyy>
          <izz>0.05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="link_2_l_visual">
        <geometry>
          <mesh>
            <uri>model://yaskawa_hc10/meshes/hc10/visual/link_2_l.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="link_3_u">
      <pose relative_to="joint_3_u">0 0 0 0 0 0</pose>
      <inertial>
        <mass>6.0</mass>
        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.05</iyy>
          <izz>0.04</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="link_3_u_visual">
        <geometry>
          <mesh>
            <uri>model://yaskawa_hc10/meshes/hc10/visual/link_3_u.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="link_4_r">
      <pose relative_to="joint_4_r">0 0 0 0 0 0</pose>
      <inertial>
        <mass>3.5</mass>
        <inertia>
          <ixx>0.03</ixx>
          <iyy>0.03</iyy>
          <izz>0.02</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="link_4_r_visual">
        <geometry>
          <mesh>
            <uri>model://yaskawa_hc10/meshes/hc10/visual/link_4_r.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="link_5_b">
      <pose relative_to="joint_5_b">0 0 0 0 0 0</pose>
      <inertial>
        <mass>2.5</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.015</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="link_5_b_visual">
        <geometry>
          <mesh>
            <uri>model://yaskawa_hc10/meshes/hc10/visual/link_5_b.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="link_6_t">
      <pose relative_to="joint_6_t">0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.008</ixx>
          <iyy>0.008</iyy>
          <izz>0.006</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="link_6_t_visual">
        <geometry>
          <mesh>
            <uri>model://yaskawa_hc10/meshes/hc10/visual/link_6_t.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="tool0">
      <pose relative_to="joint_6_t-tool0">0 0 0 0 0 0</pose>
    </link>
    <link name="base">
      <pose relative_to="base_link-base">0 0 0 0 0 0</pose>
    </link>
    <link name="gripper">
      <pose relative_to="tool0-gripper">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.04035 0 0.0241 0 0 0</pose>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.0007</ixx>
          <iyy>0.0012</iyy>
          <izz>0.0011</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- The source CAD is a monolithic assembly containing fixed jaw-base
           components. Keep it as a source asset, but render a local static
           housing so only the dedicated jaw links can move. -->
      <visual name="zimmer_geh6040il_body_visual">
        <pose>0 0 0.024 0 0 0</pose>
        <geometry>
          <box>
            <size>0.090 0.078 0.048</size>
          </box>
        </geometry>
        <material>
          <ambient>0.22 0.23 0.23 1</ambient>
          <diffuse>0.22 0.23 0.23 1</diffuse>
        </material>
      </visual>
      <visual name="zimmer_geh6040il_lower_cap_visual">
        <pose>0 0 0.004 0 0 0</pose>
        <geometry>
          <box>
            <size>0.094 0.080 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0.16 0.17 0.17 1</ambient>
          <diffuse>0.16 0.17 0.17 1</diffuse>
        </material>
      </visual>
      <visual name="zimmer_geh6040il_top_guide_visual">
        <pose>0 0 0.047 0 0 0</pose>
        <geometry>
          <box>
            <size>0.072 0.042 0.004</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.13 0.13 1</ambient>
          <diffuse>0.12 0.13 0.13 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="gripper_left_jaw">
      <pose relative_to="gripper_left_jaw_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.038 0 0 0</pose>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.00004</ixx>
          <iyy>0.00004</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="left_jaw_mount_visual">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <box>
            <size>0.022 0.028 0.010</size>
          </box>
        </geometry>
        <material>
          <ambient>0.62 0.64 0.64 1</ambient>
          <diffuse>0.62 0.64 0.64 1</diffuse>
        </material>
      </visual>
      <visual name="left_jaw_slider_visual">
        <pose>0.0125 0 0.001 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.012 0.006</size>
          </box>
        </geometry>
        <material>
          <ambient>0.42 0.44 0.44 1</ambient>
          <diffuse>0.42 0.44 0.44 1</diffuse>
        </material>
      </visual>
      <visual name="left_jaw_finger_visual">
        <pose>0 0 0.040 0 0 0</pose>
        <geometry>
          <box>
            <size>0.012 0.018 0.060</size>
          </box>
        </geometry>
        <material>
          <ambient>0.62 0.64 0.64 1</ambient>
          <diffuse>0.62 0.64 0.64 1</diffuse>
        </material>
      </visual>
      <visual name="left_jaw_pad_visual">
        <pose>0.0075 0 0.0525 0 0 0</pose>
        <geometry>
          <box>
            <size>0.003 0.019 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="gripper_right_jaw">
      <pose relative_to="gripper_right_jaw_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.038 0 0 0</pose>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.00004</ixx>
          <iyy>0.00004</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="right_jaw_mount_visual">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <box>
            <size>0.022 0.028 0.010</size>
          </box>
        </geometry>
        <material>
          <ambient>0.62 0.64 0.64 1</ambient>
          <diffuse>0.62 0.64 0.64 1</diffuse>
        </material>
      </visual>
      <visual name="right_jaw_slider_visual">
        <pose>-0.0125 0 0.001 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.012 0.006</size>
          </box>
        </geometry>
        <material>
          <ambient>0.42 0.44 0.44 1</ambient>
          <diffuse>0.42 0.44 0.44 1</diffuse>
        </material>
      </visual>
      <visual name="right_jaw_finger_visual">
        <pose>0 0 0.040 0 0 0</pose>
        <geometry>
          <box>
            <size>0.012 0.018 0.060</size>
          </box>
        </geometry>
        <material>
          <ambient>0.62 0.64 0.64 1</ambient>
          <diffuse>0.62 0.64 0.64 1</diffuse>
        </material>
      </visual>
      <visual name="right_jaw_pad_visual">
        <pose>-0.0075 0 0.0525 0 0 0</pose>
        <geometry>
          <box>
            <size>0.003 0.019 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="gripper_tcp">
      <pose relative_to="gripper_tcp_joint">0 0 0 0 0 0</pose>
    </link>

    <joint name="world_joint" type="fixed">
      <parent>world</parent>
      <child>base_link</child>
    </joint>

    <joint name="joint_1_s" type="revolute">
      <parent>base_link</parent>
      <child>link_1_s</child>
      <pose relative_to="base_link">0 0 0.275 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159265359</lower>
          <upper>3.14159265359</upper>
          <effort>700.0</effort>
          <velocity>2.26892802759</velocity>
        </limit>
        <dynamics>
          <damping>10.0</damping>
          <friction>2.0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="joint_2_l" type="revolute">
      <parent>link_1_s</parent>
      <child>link_2_l</child>
      <pose relative_to="link_1_s">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-3.14159265359</lower>
          <upper>3.14159265359</upper>
          <effort>700.0</effort>
          <velocity>2.26892802759</velocity>
        </limit>
        <dynamics>
          <damping>10.0</damping>
          <friction>2.0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="joint_3_u" type="revolute">
      <parent>link_2_l</parent>
      <child>link_3_u</child>
      <pose relative_to="link_2_l">0 0 0.700 0 0 0</pose>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-0.08726646260</lower>
          <upper>6.19591884458</upper>
          <effort>260.0</effort>
          <velocity>3.14159265359</velocity>
        </limit>
        <dynamics>
          <damping>8.0</damping>
          <friction>1.6</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="joint_4_r" type="revolute">
      <parent>link_3_u</parent>
      <child>link_4_r</child>
      <pose relative_to="link_3_u">0 0 -0.500 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159265359</lower>
          <upper>3.14159265359</upper>
          <effort>39.20</effort>
          <velocity>3.14159265359</velocity>
        </limit>
        <dynamics>
          <damping>4.0</damping>
          <friction>0.8</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="joint_5_b" type="revolute">
      <parent>link_4_r</parent>
      <child>link_5_b</child>
      <pose relative_to="link_4_r">0 0.162 0 0 0 0</pose>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
          <lower>-3.14159265359</lower>
          <upper>3.14159265359</upper>
          <effort>31.36</effort>
          <velocity>4.36332312999</velocity>
        </limit>
        <dynamics>
          <damping>3.0</damping>
          <friction>0.6</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="joint_6_t" type="revolute">
      <parent>link_5_b</parent>
      <child>link_6_t</child>
      <pose relative_to="link_5_b">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159265359</lower>
          <upper>3.14159265359</upper>
          <effort>31.36</effort>
          <velocity>4.36332312999</velocity>
        </limit>
        <dynamics>
          <damping>2.0</damping>
          <friction>0.5</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="joint_6_t-tool0" type="fixed">
      <parent>link_6_t</parent>
      <child>tool0</child>
      <pose relative_to="link_6_t">0 0 -0.130 3.14159265359 0 0</pose>
    </joint>

    <joint name="tool0-gripper" type="fixed">
      <parent>tool0</parent>
      <child>gripper</child>
      <pose relative_to="tool0">0 0 0 0 0 0</pose>
    </joint>

    <!-- q = 0 is closed; one positive command opens both jaws. -->
    <joint name="gripper_left_jaw_joint" type="prismatic">
      <parent>gripper</parent>
      <child>gripper_left_jaw</child>
      <pose relative_to="gripper">-0.025 0 0.0482 0 0 0</pose>
      <axis>
        <xyz>-1 0 0</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>0.040</upper>
          <effort>80.0</effort>
          <velocity>0.06</velocity>
        </limit>
        <dynamics>
          <damping>2.0</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="gripper_right_jaw_joint" type="prismatic">
      <parent>gripper</parent>
      <child>gripper_right_jaw</child>
      <pose relative_to="gripper">0.025 0 0.0482 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>0.040</upper>
          <effort>80.0</effort>
          <velocity>0.06</velocity>
        </limit>
        <dynamics>
          <damping>2.0</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="gripper_tcp_joint" type="fixed">
      <parent>gripper</parent>
      <child>gripper_tcp</child>
      <pose relative_to="gripper">0 0 0.1182 0 0 0</pose>
    </joint>

    <joint name="base_link-base" type="fixed">
      <parent>base_link</parent>
      <child>base</child>
      <pose relative_to="base_link">0 0 0.275 0 0 0</pose>
    </joint>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <joint_name>joint_1_s</joint_name>
      <joint_name>joint_2_l</joint_name>
      <joint_name>joint_3_u</joint_name>
      <joint_name>joint_4_r</joint_name>
      <joint_name>joint_5_b</joint_name>
      <joint_name>joint_6_t</joint_name>
      <joint_name>gripper_left_jaw_joint</joint_name>
      <joint_name>gripper_right_jaw_joint</joint_name>
    </plugin>

    <plugin
      filename="gz-sim-joint-trajectory-controller-system"
      name="gz::sim::systems::JointTrajectoryController">
      <joint_name>joint_1_s</joint_name>
      <initial_position>0.0</initial_position>
      <position_p_gain>450.0</position_p_gain>
      <position_i_gain>0.0</position_i_gain>
      <position_d_gain>85.0</position_d_gain>
      <position_i_min>0.0</position_i_min>
      <position_i_max>0.0</position_i_max>
      <position_cmd_min>-500.0</position_cmd_min>
      <position_cmd_max>500.0</position_cmd_max>

      <joint_name>joint_2_l</joint_name>
      <initial_position>0.0</initial_position>
      <position_p_gain>520.0</position_p_gain>
      <position_i_gain>0.0</position_i_gain>
      <position_d_gain>100.0</position_d_gain>
      <position_i_min>0.0</position_i_min>
      <position_i_max>0.0</position_i_max>
      <position_cmd_min>-550.0</position_cmd_min>
      <position_cmd_max>550.0</position_cmd_max>

      <joint_name>joint_3_u</joint_name>
      <initial_position>0.0</initial_position>
      <position_p_gain>420.0</position_p_gain>
      <position_i_gain>0.0</position_i_gain>
      <position_d_gain>80.0</position_d_gain>
      <position_i_min>0.0</position_i_min>
      <position_i_max>0.0</position_i_max>
      <position_cmd_min>-260.0</position_cmd_min>
      <position_cmd_max>260.0</position_cmd_max>

      <joint_name>joint_4_r</joint_name>
      <initial_position>0.0</initial_position>
      <position_p_gain>120.0</position_p_gain>
      <position_i_gain>0.0</position_i_gain>
      <position_d_gain>28.0</position_d_gain>
      <position_i_min>0.0</position_i_min>
      <position_i_max>0.0</position_i_max>
      <position_cmd_min>-90.0</position_cmd_min>
      <position_cmd_max>90.0</position_cmd_max>

      <joint_name>joint_5_b</joint_name>
      <initial_position>0.0</initial_position>
      <position_p_gain>90.0</position_p_gain>
      <position_i_gain>0.0</position_i_gain>
      <position_d_gain>22.0</position_d_gain>
      <position_i_min>0.0</position_i_min>
      <position_i_max>0.0</position_i_max>
      <position_cmd_min>-70.0</position_cmd_min>
      <position_cmd_max>70.0</position_cmd_max>

      <joint_name>joint_6_t</joint_name>
      <initial_position>0.0</initial_position>
      <position_p_gain>70.0</position_p_gain>
      <position_i_gain>0.0</position_i_gain>
      <position_d_gain>18.0</position_d_gain>
      <position_i_min>0.0</position_i_min>
      <position_i_max>0.0</position_i_max>
      <position_cmd_min>-60.0</position_cmd_min>
      <position_cmd_max>60.0</position_cmd_max>
    </plugin>

    <plugin
      filename="mfja-symmetric-gripper-controller-system"
      name="mfja::sim::systems::SymmetricGripperController">
      <left_joint_name>gripper_left_jaw_joint</left_joint_name>
      <right_joint_name>gripper_right_jaw_joint</right_joint_name>
      <sub_topic>gripper/position_command</sub_topic>
      <min_position>0.0</min_position>
      <max_position>0.040</max_position>
      <max_velocity>0.06</max_velocity>
      <initial_position>0.0</initial_position>
    </plugin>
  </model>
</sdf>
