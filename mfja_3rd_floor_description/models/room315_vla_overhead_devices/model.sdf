<?xml version="1.0"?>
<sdf version="1.7">
  <model name="room315_vla_overhead_devices">
    <static>true</static>

    <link name="right_rail_rgbd_camera_link">
      <pose>-15.05 -4.70 3.15 0 1.5708 0</pose>
      <visual name="camera_body_visual">
        <geometry>
          <box>
            <size>0.24 0.16 0.09</size>
          </box>
        </geometry>
        <material>
          <ambient>0.04 0.045 0.055 1</ambient>
          <diffuse>0.04 0.045 0.055 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
      <visual name="camera_lens_visual">
        <pose>0.14 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.025 1</ambient>
          <diffuse>0.02 0.02 0.025 1</diffuse>
          <specular>0.8 0.8 0.9 1</specular>
        </material>
      </visual>
      <sensor name="room315_vla_right_rail_rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>/room_315/vla/right_rail_rgbd</topic>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.15</near>
            <far>5.0</far>
          </clip>
          <optical_frame_id>room315_vla_right_rail_rgbd_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </link>

