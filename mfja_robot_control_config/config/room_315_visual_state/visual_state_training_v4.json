{
  "schema_version": "room315.visual_training.v4.pilot_config.v1",
  "purpose": "isolated V4 segment-first visual-state training; never changes the approved V3 runtime or report",
  "environment_defaults": {
    "ROOM315_APPROVED_RUN_ROOT": "/home/tiago/room315_full_training_approved_archive_seed31520260730/results/run",
    "ROOM315_OLD_DATASET_ROOT": "/home/tiago/room315_arbitrary_subset_visual_2040_capture_v2_seed31520260729/dataset",
    "ROOM315_OLD_SPLITS_ROOT": "/home/tiago/room315_arbitrary_subset_visual_splits_v1_seed31520260730",
    "ROOM315_V3R1_CANARY_ROOT": "/home/tiago/room315_hard_case_visual_v3r1_canary_seed31520260730",
    "ROOM315_V3R1_DATASET_ROOT": "/home/tiago/room315_hard_case_visual_v3r1_capture_seed31520260730/dataset",
    "ROOM315_V3R1_SPLITS_ROOT": "/home/tiago/room315_hard_case_visual_v3r1_splits_seed31520260730",
    "ROOM315_V4_BLOCKER_ROOT": "/home/tiago/room315_visual_state_v4_blockers",
    "ROOM315_V4_OUTPUT_ROOT": "/home/tiago/room315_visual_v4_outputs"
  },
  "data": {
    "train_sources": [
      {
        "name": "old_replay",
        "dataset_root": "${ROOM315_OLD_DATASET_ROOT}",
        "rows": "${ROOM315_OLD_SPLITS_ROOT}/train.jsonl",
        "labels": "${ROOM315_OLD_SPLITS_ROOT}/train_visual_labels.jsonl",
        "epoch_fraction": 0.5,
        "expected_rows": 1528,
        "enabled": true
      },
      {
        "name": "v3r1_hard_case",
        "dataset_root": "${ROOM315_V3R1_DATASET_ROOT}",
        "rows": "${ROOM315_V3R1_SPLITS_ROOT}/train.jsonl",
        "labels": "${ROOM315_V3R1_SPLITS_ROOT}/train_visual_labels.jsonl",
        "epoch_fraction": 0.5,
        "expected_rows": 4000,
        "enabled": true
      },
      {
        "name": "v4_blocker_pilot",
        "dataset_root": "${ROOM315_V4_BLOCKER_ROOT}",
        "rows": "${ROOM315_V4_BLOCKER_ROOT}/splits/train.jsonl",
        "labels": "${ROOM315_V4_BLOCKER_ROOT}/splits/train_visual_labels.jsonl",
        "epoch_fraction": 0.0,
        "expected_rows": 35,
        "enabled": false,
        "reason_disabled": "enable only as a separately measured ablation; 35 rows are too small to mix silently"
      }
    ],
    "validation": {
      "name": "v3r1_validation",
      "dataset_root": "${ROOM315_V3R1_DATASET_ROOT}",
      "rows": "${ROOM315_V3R1_SPLITS_ROOT}/validation.jsonl",
      "labels": "${ROOM315_V3R1_SPLITS_ROOT}/validation_visual_labels.jsonl",
      "expected_rows": 512
    },
    "canary": {
      "name": "v3r1_canary",
      "dataset_root": "${ROOM315_V3R1_CANARY_ROOT}/dataset",
      "rows": "${ROOM315_V3R1_CANARY_ROOT}/finalized/canary.jsonl",
      "labels": "${ROOM315_V3R1_CANARY_ROOT}/finalized/canary_visual_labels.jsonl",
      "expected_rows": 256
    }
  },
  "data_roles": {
    "checkpoint_selection": "validation_only",
    "canary": "post-training development regression only",
    "legacy_grouped_validation": "historical predecessor partition; forbidden as a direct V4 input",
    "legacy_grouped_test": "consumed historical Test; forbidden as a direct V4 input",
    "test": "forbidden during V4 development and absent from this configuration"
  },
  "initialization": {
    "kind": "verified_v3_backbone_only",
    "checkpoint": "${ROOM315_APPROVED_RUN_ROOT}/best.pt",
    "checkpoint_sha256": "8a2d865e3d3551ec4284b53aa913d66f24640e23556f2f26b49a165f3ce8d51d",
    "copy_shared_stem": true,
    "copy_layer4_to_both_rails": true,
    "copy_v3_joint_head": false
  },
  "approved_v3_validation_baseline": {
    "checkpoint_sha256": "8a2d865e3d3551ec4284b53aa913d66f24640e23556f2f26b49a165f3ce8d51d",
    "validation_rows_sha256": "a4c90ac7c1043450830f69ad90094e9aacac92ad57f24fcd4439b0b2a14c9fd7",
    "validation_labels_sha256": "d62310046e9a6737e69d7d0e702f05e1073ae7de8f12b2c64655d510b410e1ab",
    "sample_count": 512,
    "visible_count": 2254,
    "loaded_correct_count": 1492,
    "loaded_accuracy": 0.6619343389529725,
    "segment_correct_count": 1164,
    "segment_top1_accuracy": 0.5164152617568767,
    "segment_top1_left": 0.4534562211981567,
    "segment_top1_right": 0.5748502994011976,
    "data_role": "validation_only",
    "preprocessing_contract": "v3_direct_bilinear_224_imagenet_normalization_target_stats_decode"
  },
  "topology_contract": {
    "segment_name_domain": "public_ros_label",
    "length_loader": "room_315_rail_defaults.public_rail_segment_lengths",
    "forbid_internal_rail_segment_lengths": true,
    "store_length_mapping_fingerprint_in_checkpoint": true,
    "verify_length_mapping_fingerprint_at_runtime": true
  },
  "model": {
    "kind": "room315_visual_state_resnet18_split_rails_v4",
    "head_type": "spatial_query",
    "hidden_dim": 256,
    "attention_heads": 8,
    "dropout": 0.1,
    "slot_order": ["L1", "L2", "L3", "L4", "R1", "R2", "R3", "R4"],
    "cross_camera_feature_path": false
  },
  "image_preprocessing": {
    "width": 320,
    "height": 240,
    "resize": "aspect_preserving_bilinear_4_by_3",
    "normalization_mean": [0.485, 0.456, 0.406],
    "normalization_std": [0.229, 0.224, 0.225],
    "train_augmentations": {
      "horizontal_flip": false,
      "camera_swap": false,
      "brightness": 0.15,
      "contrast": 0.15,
      "saturation": 0.08,
      "gamma_min": 0.9,
      "gamma_max": 1.1,
      "gaussian_blur_probability": 0.15,
      "gaussian_noise_probability": 0.15,
      "gaussian_noise_std": 0.01
    }
  },
  "sampling": {
    "records_per_source_per_epoch": 4000,
    "source_balance": "explicit_epoch_fraction",
    "within_source_balance": "inverse_sqrt_side_segment_frequency",
    "sample_weight_min": 0.5,
    "sample_weight_max": 3.0,
    "boundary_multiplier": 1.5,
    "switch_multiplier": 2.0,
    "multi_blocker_multiplier": 1.5
  },
  "loss": {
    "segment": {
      "kind": "masked_side_weighted_cross_entropy",
      "weight": 4.0,
      "class_weighting": "inverse_sqrt_frequency_by_side_from_train_only",
      "class_weight_min": 0.5,
      "class_weight_max": 2.5,
      "label_smoothing": 0.02
    },
    "s_ratio": {
      "kind": "masked_smooth_l1",
      "weight": 2.0,
      "beta": 0.05
    },
    "loaded_state": {
      "kind": "masked_cross_entropy",
      "weight": 1.0,
      "label_smoothing": 0.01
    },
    "bbox": {
      "kind": "masked_normalized_l1_plus_giou",
      "weight": 1.0,
      "l1_weight": 1.0,
      "giou_weight": 1.0
    },
    "topology": {
      "kind": "expected_normalized_graph_distance",
      "weight": 0.25,
      "segment_name_domain": "public_ros_label"
    }
  },
  "training": {
    "device": "cuda",
    "automatic_mixed_precision": true,
    "amp_initial_scale": 8192.0,
    "batch_size": 24,
    "gradient_accumulation_steps": 1,
    "epochs": 12,
    "early_stopping_patience": 4,
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "weight_decay": 0.0001,
    "gradient_clip_norm": 5.0,
    "heads_learning_rate": 0.0003,
    "layer4_learning_rate": 0.0001,
    "shared_layer3_learning_rate": 0.00002,
    "heads_only_through_epoch": 1,
    "unfreeze_layer4_at_epoch": 2,
    "unfreeze_shared_layer3_at_epoch": 4,
    "seed": 31520260811,
    "checkpoint_selection": [
      "highest_validation_planning_score",
      "highest_validation_worst_side_x_segment_recall",
      "lowest_validation_correct_segment_s_m_p95"
    ]
  },
  "evaluation": {
    "planning_score_weights": {
      "segment_macro_f1": 0.3,
      "minimum_side_top1": 0.15,
      "worst_side_x_segment_recall": 0.2,
      "joint_segment_and_ratio_005": 0.2,
      "switch_zone_segment_top1": 0.075,
      "boundary_zone_segment_top1": 0.075
    },
    "required_breakdowns": [
      "side",
      "identity",
      "segment",
      "side_x_segment",
      "target_zone",
      "position_bin",
      "scene_occlusion_class",
      "scene_presence_density"
    ],
    "required_counterfactuals": [
      "blank_opposite_camera",
      "shuffle_opposite_camera",
      "camera_order_swap_canary"
    ],
    "calibrate_segment_temperature_on_validation": true,
    "report_selective_accuracy_and_coverage": true,
    "segment_calibration": {
      "coverage_targets": [1.0, 0.95, 0.9, 0.8, 0.7],
      "ece_bins": 15,
      "minimum_temperature": 0.05,
      "maximum_temperature": 20.0,
      "grid_size": 129,
      "refinement_steps": 4
    }
  },
  "pilot_acceptance_gates": {
    "minimum_segment_top1_each_side": 0.75,
    "minimum_segment_macro_recall_each_side": 0.75,
    "zero_supported_segment_classes_with_zero_recall": true,
    "zero_supported_side_x_segment_cells_with_zero_recall": true,
    "minimum_worst_side_x_segment_recall": 0.5,
    "maximum_correct_segment_s_m_mae_m": 0.12,
    "maximum_correct_segment_s_m_mae_m_each_side": 0.12,
    "minimum_correct_segment_s_m_coverage_each_side": 0.75,
    "minimum_joint_segment_and_ratio_005_accuracy": 0.7,
    "minimum_joint_segment_and_ratio_005_accuracy_each_side": 0.7,
    "minimum_identity_zone_switch_segment_top1": 0.75,
    "minimum_identity_zone_boundary_segment_top1": 0.75,
    "minimum_position_bin_segment_top1": 0.7,
    "minimum_position_bin_joint_segment_and_ratio_005_accuracy": 0.6,
    "minimum_scene_occlusion_segment_top1": 0.7,
    "minimum_scene_occlusion_joint_segment_and_ratio_005_accuracy": 0.6,
    "minimum_scene_presence_density_segment_top1": 0.7,
    "minimum_scene_presence_density_joint_segment_and_ratio_005_accuracy": 0.6,
    "minimum_loaded_accuracy": 0.95,
    "maximum_loaded_accuracy_drop": 0.01,
    "cross_side_output_change_tolerance": 0.000001,
    "minimum_camera_order_swap_segment_top1_drop": 0.3,
    "automatic_runtime_switch": false
  },
  "output_root": "${ROOM315_V4_OUTPUT_ROOT}"
}
