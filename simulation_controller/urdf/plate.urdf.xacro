<?xml version="1.0"?>
<robot name="plate" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="plate">
    <visual>
      <origin xyz="0.3 0.0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.4 0.2"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

</robot>